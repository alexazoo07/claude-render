   "language": "es",
   "owner": "24d8009359e42cf29eec7246fb0bfdc0070cdaf1e1af88985991334d6b8c26e1"
  },
  {
   "id": "ant_0",
   "voice": "0DRWFZS24qw1EtEs7073",
   "text": "[emocionado] ¡Eh, ave María, pues! Antioquia también se independiza, como en 1813.",
