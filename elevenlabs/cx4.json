   "language": "es",
   "owner": "87add6aa5d545d489b2a0e8e4372afae97fbfa50cf2a58e3d25781f740736aea"
  },
  {
   "id": "car_0",
   "voice": "C2jL5LUEDZwtU8FfMBHA",
   "text": "[orgulloso] ¡Ajá, cachaco! Cartagena fue la primera en declararse libre, en 1811.",
   "stability": 0.0,
   "language": "es",
   "owner": "24d8009359e42cf29eec7246fb0bfdc0070cdaf1e1af88985991334d6b8c26e1"
  },
  {
   "id": "car_1",
   "voice": "MFczlrjgpEos5t8Rwlto",
   "text": "[gritando] ¡Pero te llevas la costa, las murallas y el vallenato!",
   "stability": 0.0,
   "language": "es",
   "owner": "87add6aa5d545d489b2a0e8e4372afae97fbfa50cf2a58e3d25781f740736aea"
  },
