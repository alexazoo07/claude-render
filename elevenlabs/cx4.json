   "id": "intro",
   "voice": "MFczlrjgpEos5t8Rwlto",
   "text": "[orgulloso] ¡Sí, señor! Soy Colombia… [nervioso] bueno, la Colombia de 1900. ¿Ven ese pedacito de arriba?",
   "stability": 0.0,
   "language": "es",
   "owner": "87add6aa5d545d489b2a0e8e4372afae97fbfa50cf2a58e3d25781f740736aea"
  },
  {
   "id": "fin",
   "voice": "MFczlrjgpEos5t8Rwlto",
   "text": "[suspira] Sin Panamá, sin costa y sin capital… [preocupado] ¿quién sigue, parce?",
   "stability": 0.0,
   "language": "es",
   "owner": "87add6aa5d545d489b2a0e8e4372afae97fbfa50cf2a58e3d25781f740736aea"
  },
  {
   "id": "pan_0",
   "voice": "64iVJ7QB471BXdqed0KJ",
   "text": "[decidido] ¡Me voy, Colombia! Desde hoy, 3 de noviembre de 1903, soy Panamá.",
   "stability": 0.0,
   "language": "es",
   "owner": "65cac8fd4022e8ea767cc23db4f8021a5d4a7f0517fc6a160d26dd45ef5a0c57"
  },
  {
   "id": "pan_1",
   "voice": "TX3LPaxmHKxFdv7VOQHJ",
   "text": "[sonriente] Y yo te ayudo, amigo… a cambio de un pequeño canal.",
   "stability": 0.0,
   "language": "es"
  },
  {
   "id": "pan_2",
   "voice": "MFczlrjgpEos5t8Rwlto",
   "text": "[furioso] ¡¿Un canal?! ¡Eso es un robo, gringos!",
